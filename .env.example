# PulseGrid environment template.
#   cp .env.example .env
# Every value here is a safe local-development placeholder. Nothing in this
# file is a real secret, and .env itself is git-ignored.

# --- Environment ------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL (consumed by the `db` service) ------------------------------
POSTGRES_USER=pulsegrid
POSTGRES_PASSWORD=pulsegrid_dev_password
POSTGRES_DB=pulsegrid

# --- Database URL (consumed by the API and by Alembic) ----------------------
# Inside docker compose the host is `db`; docker-compose.yml overrides this.
# The value below is what you want when running the API on your own machine.
# Note the psycopg 3 scheme: postgresql+psycopg://  (not +psycopg2)
DATABASE_URL=postgresql+psycopg://pulsegrid:pulsegrid_dev_password@localhost:5432/pulsegrid

# --- Auth -------------------------------------------------------------------
# Generate a real one for anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Background jobs --------------------------------------------------------
SCHEDULER_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=60

# --- Live dashboard stream --------------------------------------------------
SSE_HEARTBEAT_SECONDS=5

# --- Upstreams --------------------------------------------------------------
DEMO_TARGET_URL=http://demo-target:8001
