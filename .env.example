# PulseGrid environment template.
#   cp .env.example .env
# Every value here is a safe local-development placeholder. Nothing in this
# file is a real secret, and .env itself is git-ignored.

# --- Environment ------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO

# Which environment the compose stack presents itself as, in the dashboard's
# infrastructure panel: development | qa | production (staging/uat group with
# QA). Every service is labelled with this, so changing it and re-running
# `docker compose up -d` moves the whole stack between the panel's tabs.
PULSEGRID_ENV=development

# --- PostgreSQL (consumed by the `db` service) ------------------------------
POSTGRES_USER=pulsegrid
POSTGRES_PASSWORD=pulsegrid_dev_password
POSTGRES_DB=pulsegrid

# --- Database URL (consumed by the API and by Alembic) ----------------------
# Inside docker compose the host is `db`; docker-compose.yml overrides this.
# The value below is what you want when running the API on your own machine.
# Note the psycopg 3 scheme: postgresql+psycopg://  (not +psycopg2)
DATABASE_URL=postgresql+psycopg://pulsegrid:pulsegrid_dev_password@localhost:5432/pulsegrid

# --- Auth -------------------------------------------------------------------
# Generate a real one for anything but local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Background jobs --------------------------------------------------------
SCHEDULER_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=60

# --- Live dashboard stream --------------------------------------------------
SSE_HEARTBEAT_SECONDS=5

# --- Upstreams --------------------------------------------------------------
DEMO_TARGET_URL=http://demo-target:8001

# --- Collection -------------------------------------------------------------
# Upstream timeout for the reverse proxy, in seconds.
PROXY_TIMEOUT_SECONDS=15
# The prober runs faster than the rollup on purpose, so each closed minute
# bucket covers several observations and its percentiles mean something.
PROBE_INTERVAL_SECONDS=15
PROBE_TIMEOUT_SECONDS=10
ROLLUP_INTERVAL_SECONDS=30
# Trailing window the rollup re-aggregates every run, so late-arriving rows are
# still counted. Re-processing is safe: the unique constraint makes it an upsert.
ROLLUP_LOOKBACK_MINUTES=5

# --- ML ---------------------------------------------------------------------
ANOMALY_INTERVAL_SECONDS=60
# How much history the detectors baseline against.
ANOMALY_WINDOW_MINUTES=120
FORECAST_INTERVAL_SECONDS=300
FORECAST_HORIZON_MINUTES=60

# --- Runtime infrastructure discovery ---------------------------------------
# The dashboard reads the live container runtime to show what is running, which
# ports it publishes and which localhost URLs those resolve to. Nothing here
# needs setting for the compose stack: the API finds its own compose project
# through the socket mounted in docker-compose.yml, and the panel degrades to a
# clean "runtime unreachable" state when the socket is absent.
#
# DOCKER_HOST accepts unix:// and tcp:// exactly as the Docker CLI does.
# DOCKER_HOST=unix:///var/run/docker.sock
# Group that owns /var/run/docker.sock, which the API joins so its unprivileged
# user can read it. 0 is right for Docker Desktop; on a Linux host read the real
# value with:  stat -c '%g' /var/run/docker.sock
# DOCKER_SOCKET_GID=0
# Restrict discovery to one compose project, or `all` for every container on
# the host. Empty (the default) scopes it to the project the API is part of.
# INFRA_PROJECT=
# Hostname published ports are addressed on when they are bound to a specific
# interface. Wildcard binds are re-hosted onto whatever origin the dashboard
# itself was loaded from, so this rarely needs changing.
# INFRA_PUBLIC_HOST=localhost
# Confirm discovered HTTP endpoints actually answer, over the container network.
# INFRA_PROBE_ENABLED=true

# --- Demo provisioning ------------------------------------------------------
# Registers the three demo endpoints and an operator account on first boot, so
# a fresh stack charts something immediately. Turn this OFF for any real
# deployment — it also creates a well-known password.
DEMO_AUTOSEED=true
DEMO_ADMIN_EMAIL=admin@pulsegrid.dev
DEMO_ADMIN_PASSWORD=pulsegrid-demo
